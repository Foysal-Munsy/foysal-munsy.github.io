---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import ListRow from "../components/ListRow.astro";
import WorkRow from "../components/WorkRow.astro";
import CpRow from "../components/CpRow.astro";
import ProjectCard from "../components/ProjectCard.astro";
import TechBadge from "../components/TechBadge.astro";
import InterestChips from "../components/InterestChips.astro";
import ResearchRow from "../components/ResearchRow.astro";
import ResearchLinks from "../components/ResearchLinks.astro";
import { featuredProjects as featuredRepos } from "../data/featuredProjects";
import {
  profile,
  work,
  education,
  skillGroups,
  competitiveProgramming,
  cpSummary,
  contests,
} from "../data/resume";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;

// Featured GitHub repos (tagged `featured` on GitHub) surfaced on the
// homepage; full list lives on /projects. Capped so the homepage stays tight.
const projectItems = featuredRepos.slice(0, 4);

const featuredResearch = (await getCollection("research"))
  .filter((e) => !e.data.draft && e.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${profile.name} — ${profile.role}`}>
  <Hero />

  <Section title="About" delay={0.1}>
    <p class="about">{profile.about}</p>
  </Section>

  <Section title="Work Experience" delay={0.15}>
    {/* Keep the current role expanded so skimmers see the bullets. */}
    {
      work.map((w, i) => (
        <WorkRow
          logo={w.logo}
          title={w.company}
          meta={w.period}
          subtitle={w.role}
          location={w.location}
          points={w.points}
          defaultOpen={i === 0}
        />
      ))
    }
  </Section>

  <Section title="Education" delay={0.2}>
    {
      education.map((e) => (
        <ListRow logo={e.logo} title={e.institution} meta={e.period}>
          <div class="edu-detail">
            {e.detail.map((line) => (
              <span>{line}</span>
            ))}
          </div>
        </ListRow>
      ))
    }
  </Section>

  <Section title="Skills" delay={0.25}>
    <div class="skill-groups">
      {
        skillGroups.map((group) => (
          <div class="skill-group">
            <h3 class="skill-label">{group.label}</h3>
            <div class="chips">
              {group.items.map((s) => <TechBadge label={s} size="lg" />)}
            </div>
          </div>
        ))
      }
    </div>
  </Section>

  <Section title="Competitive Programming" delay={0.3}>
    {
      competitiveProgramming.map((c) => (
        <CpRow
          platform={c.platform}
          handle={c.handle}
          profileUrl={c.profileUrl}
          rank={c.rank}
          rankColor={c.rankColor}
          ratingDetail={c.ratingDetail}
          note={c.note}
          logo={c.logo}
        />
      ))
    }

    <div class="overall">
      <span class="overall-label">Overall</span>
      <div class="overall-body">
        <p class="overall-summary">{cpSummary}</p>
        <ul class="contests">
          {
            contests.map((c) => (
              <li>
                <span class="contest-name">{c.name}</span>
                {c.detail && <span class="contest-detail"> · {c.detail}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Section>

  {
    featuredResearch.length > 0 && (
      <Section
        eyebrow="Research"
        title="From computer vision to coding agents"
        subtitle="One published journal paper on robust object detection, a BSc thesis on detection for autonomous vehicles, and active work on AI for software engineering: how to build coding agents and, just as importantly, how to evaluate them honestly."
        delay={0.35}
      >
        <div class="res-chips">
          <InterestChips chips={profile.researchInterests} />
        </div>

        <div class="res-links">
          <ResearchLinks align="center" />
        </div>

        <div class="rows">
          {featuredResearch.map((r) => <ResearchRow entry={r} />)}
        </div>

        <a class="see-all" href={`${home}research`}>
          All research →
        </a>
      </Section>
    )
  }

  {
    projectItems.length > 0 && (
      <Section
        eyebrow="Projects"
        title="Things I've built"
        subtitle="A few things I've shipped, kept in sync with GitHub — the cover is each repo's social preview."
        delay={0.4}
      >
        <div class="project-grid">
          {projectItems.map((repo) => (
            <ProjectCard repo={repo} />
          ))}
        </div>
        <a class="see-all" href={`${home}projects`}>
          All projects →
        </a>
      </Section>
    )
  }

  <Section title="Get in touch" delay={0.45}>
    <p class="about">
      Want to talk? Reach me at
      <a class="link" href={`mailto:${profile.email}`}>{profile.email}</a>
      or find me on
      <a
        class="link"
        href={profile.github}
        target="_blank"
        rel="noopener noreferrer">GitHub</a
      >
      and
      <a
        class="link"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer">LinkedIn</a
      >.
    </p>
  </Section>
</BaseLayout>

<script>
  import "../scripts/researchCitations";
</script>

<style>
  .about {
    margin: 0;
    color: var(--text-muted);
  }

  .res-chips {
    display: flex;
    justify-content: center;
    margin-bottom: 1.1rem;
  }

  .res-links {
    display: flex;
    justify-content: center;
    margin-bottom: 1.6rem;
  }

  .rows {
    display: flex;
    flex-direction: column;
  }

  /* Each education detail (degree / major / CGPA) on its own line so long
       text never wraps awkwardly across devices. */
  .edu-detail {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    margin: 0.2rem 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* Grouped skills: a small mono uppercase label above each row of chips. */
  .skill-group {
    margin-bottom: 1.25rem;
  }

  .skill-group:last-child {
    margin-bottom: 0;
  }

  .skill-label {
    margin: 0 0 0.6rem;
    font-family: theme("fontFamily.mono");
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  /* The last CP row sits right before the Overall block, so its own
     border-bottom would stack with .overall's border-top and read as a double
     line. Drop the row's border and let .overall provide the single divider. */
  :global(.cp:has(+ .overall)) {
    border-bottom: none;
  }

  /* CV-style "Overall" block: a label column on the left, summary + contest
       list on the right. */
  .overall {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 1.25rem;
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .overall-label {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--text);
  }

  .overall-summary {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .contests {
    margin: 0.7rem 0 0;
    padding-left: 1.1rem;
    list-style: disc;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .contests li {
    margin: 0.35rem 0;
  }

  .contest-name {
    font-weight: 650;
    color: var(--text);
  }

  .contest-detail {
    color: var(--text-muted);
  }

  /* Stack the label above the content on small screens. */
  @media (max-width: 640px) {
    .overall {
      grid-template-columns: 1fr;
      gap: 0.5rem;
    }
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  /* GitHub-featured repo cards. Min ~300px keeps two comfortable columns at
     the 44rem content width, collapsing to one on small screens. */
  .project-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .see-all {
    display: inline-block;
    margin-top: 1.1rem;
    font-size: 0.88rem;
    font-weight: 600;
  }

  .link {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
