---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import { featuredProjects } from "../../data/featuredProjects";

const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;

// Ordered most-recently-pushed first by fetch_github.py.
const projects = featuredProjects;
---

<BaseLayout
  title="Projects — Foysal Munsy"
  description="Open-source projects by Foysal Munsy, kept in sync with GitHub."
>
  <PageHeader
    title="Projects"
    intro="Selected open-source projects that showcase my work and interests."
    backHref={home}
    backLabel="Home"
  />

  {
    projects.length === 0 ? (
      <p class="empty">No featured projects yet.</p>
    ) : (
      <div class="grid">
        {projects.map((repo) => (
          <ProjectCard repo={repo} />
        ))}
      </div>
    )
  }
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
