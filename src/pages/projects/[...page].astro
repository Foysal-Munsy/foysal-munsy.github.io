---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import Pagination from "../../components/Pagination.astro";
import { featuredProjects } from "../../data/featuredProjects";

export const getStaticPaths = (({ paginate }) => {
  // Ordered most-recently-pushed first by fetch_github.py.
  const projects = featuredProjects;
  return paginate(projects, { pageSize: 6 });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
const home = base.endsWith("/") ? base : `${base}/`;
---

<BaseLayout
  title="Projects — Foysal Munsy"
  description="Open-source projects by Foysal Munsy, kept in sync with GitHub."
>
  <PageHeader
    title="Projects"
    intro="Selected open-source projects that showcase my work and interests."
    backHref={home}
    backLabel="Home"
  />

  {
    page.data.length === 0 ? (
      <p class="empty">No featured projects yet.</p>
    ) : (
      <>
        <div class="grid">
          {page.data.map((repo) => (
            <ProjectCard repo={repo} />
          ))}
        </div>
        <Pagination page={page} />
      </>
    )
  }
</BaseLayout>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .empty {
    color: var(--text-muted);
  }
</style>
