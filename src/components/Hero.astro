---
import { profile } from "../data/resume";
import { Icon } from "astro-icon/components";

// Top-of-page hero: greeting + tagline on the left, avatar on the right.
// When the tagline opens with the role phrase (e.g. "Software Engineer &
// Researcher ..."), bold that whole phrase for a bit of visual emphasis.
// Otherwise fall back to bolding the first two words.
const taglineWords = profile.tagline.split(" ");
const opensWithRole = profile.tagline.startsWith(profile.role);
const taglineBold = opensWithRole
  ? profile.role
  : taglineWords.slice(0, 2).join(" ");
const taglineRest = opensWithRole
  ? profile.tagline.slice(profile.role.length).trim()
  : taglineWords.slice(2).join(" ");

// Reach-me links as brand glyphs. Per the design decision the glyphs are the
// only color on the page and always wear their brand color (no hover fill).
// Email has no brand mark, so its lucide glyph is drawn neutral/muted.
const socials = [
  { label: "Email", icon: "lucide:mail", href: `mailto:${profile.email}`, external: false, kind: "email" },
  { label: "GitHub", icon: "simple-icons:github", href: profile.github, external: true, kind: "github" },
  { label: "LinkedIn", icon: "simple-icons:linkedin", href: profile.linkedin, external: true, kind: "linkedin" },
  { label: "Google Scholar", icon: "simple-icons:googlescholar", href: profile.googleScholar, external: true, kind: "scholar" },
];
---

<section class="hero fade-up">
  <div class="text">
    <h1>{profile.greeting} 👋</h1>
    <p class="sub">
      <strong>{taglineBold}</strong>
      {taglineRest} Based in {profile.location}.
    </p>

    {
      profile.availability && (
        <p class="avail">
          <span class="avail-dot" aria-hidden="true"></span>
          {profile.availability}
        </p>
      )
    }

    <div class="socials">
      {
        socials.map((s) => (
          <a
            class={`social ${s.kind}`}
            href={s.href}
            target={s.external ? "_blank" : undefined}
            rel={s.external ? "noopener noreferrer" : undefined}
            title={s.label}
            aria-label={s.label}
          >
            <Icon name={s.icon} />
          </a>
        ))
      }
    </div>
  </div>
  <img
    class="avatar"
    src={profile.avatar}
    alt={profile.name}
    width="112"
    height="112"
    loading="eager"
  />
</section>

<style>
  .hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .hero h1 {
    font-size: 2.8rem;
    line-height: 1.1;
    margin: 0 0 0.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .sub {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.25rem;
    line-height: 1.55;
    max-width: 28rem;
  }

  .sub strong {
    font-weight: 450;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* Availability line: clean and professional, matching the site's typography but slightly more prominent than muted text. */
  .avail {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 1rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
  }

  .avail-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    flex-shrink: 0;
  }

  /* Reach-me icons: quiet bordered squares whose glyph always wears its brand
     color (email stays neutral — mail has no brand mark). Monochrome chrome,
     brand-colored glyphs only; no colored fill on hover. */
  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.15rem;
  }

  .social {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 10px;
    border: 1px solid var(--border);
    color: var(--text);
    background: transparent;
    transition:
      transform 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .social:hover {
    border-color: var(--text-muted);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .social:focus-visible {
    outline: 2px solid var(--text-muted);
    outline-offset: 2px;
  }

  .social :global(svg) {
    width: 1.18rem;
    height: 1.18rem;
  }

  /* Email has no brand color; draw it muted so it reads as the quiet one. */
  .social.email {
    color: var(--text-muted);
  }

  .social.email:hover {
    color: var(--text);
  }

  /* GitHub's mark is near-black/white by nature; let it follow the text color
     so it stays legible in both themes. */
  .social.github {
    color: var(--text);
  }

  .social.linkedin {
    color: #0a66c2;
  }

  .social.scholar {
    color: #4285f4;
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    /* Keep the avatar on the left, on the same row as the greeting.
       flex-start (instead of center) lines the avatar up with the
       "Hi, I'm Foysal" heading rather than floating in the middle. */
    .hero {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: flex-start;
      gap: 1rem;
    }

    .hero h1 {
      font-size: 1.9rem;
    }

    .avatar {
      width: 72px;
      height: 72px;
    }
  }
</style>
