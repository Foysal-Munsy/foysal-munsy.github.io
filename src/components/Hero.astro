---
import { profile } from "../data/resume";

// Top-of-page hero: greeting + tagline on the left, avatar on the right.
// When the tagline opens with the role phrase (e.g. "Software Engineer &
// Researcher ..."), bold that whole phrase for a bit of visual emphasis.
// Otherwise fall back to bolding the first two words.
const taglineWords = profile.tagline.split(" ");
const opensWithRole = profile.tagline.startsWith(profile.role);
const taglineBold = opensWithRole
  ? profile.role
  : taglineWords.slice(0, 2).join(" ");
const taglineRest = opensWithRole
  ? profile.tagline.slice(profile.role.length).trim()
  : taglineWords.slice(2).join(" ");

// Quick actions under the tagline. Kept monochrome so they sit quietly next
// to the resume content.
const ctas = [
  { label: "Email", href: `mailto:${profile.email}`, external: false },
  { label: "GitHub", href: profile.github, external: true },
  { label: "LinkedIn", href: profile.linkedin, external: true },
];
---

<section class="hero fade-up">
  <div class="text">
    <h1>{profile.greeting} 👋</h1>
    <p class="sub">
      <strong>{taglineBold}</strong>
      {taglineRest} Based in {profile.location}.
    </p>

    {
      profile.availability && (
        <p class="avail">
          <span class="avail-dot" aria-hidden="true"></span>
          {profile.availability}
        </p>
      )
    }

    <div class="ctas">
      {
        ctas.map((c) => (
          <a
            class="cta"
            href={c.href}
            target={c.external ? "_blank" : undefined}
            rel={c.external ? "noopener noreferrer" : undefined}
          >
            {c.label}
            {c.external && <span class="cta-ext" aria-hidden="true">↗</span>}
          </a>
        ))
      }
    </div>
  </div>
  <img
    class="avatar"
    src={profile.avatar}
    alt={profile.name}
    width="112"
    height="112"
    loading="eager"
  />
</section>

<style>
  .hero {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .hero h1 {
    font-size: 2.8rem;
    line-height: 1.1;
    margin: 0 0 0.7rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .sub {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.25rem;
    line-height: 1.55;
    max-width: 28rem;
  }

  .sub strong {
    font-weight: 450;
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  /* Availability line: a small green dot + status, like an online indicator. */
  .avail {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0.9rem 0 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .avail-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ok);
    flex-shrink: 0;
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: theme("fontFamily.mono");
    font-size: 0.78rem;
    color: var(--text);
    padding: 0.4rem 0.95rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease;
  }

  .cta:hover {
    background: var(--bg-subtle);
    border-color: var(--text-muted);
    text-decoration: none;
  }

  .cta-ext {
    font-size: 0.82em;
    opacity: 0.8;
  }

  .avatar {
    width: 112px;
    height: 112px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    /* Keep the avatar on the left, on the same row as the greeting.
       flex-start (instead of center) lines the avatar up with the
       "Hi, I'm Foysal" heading rather than floating in the middle. */
    .hero {
      flex-direction: row-reverse;
      justify-content: flex-end;
      align-items: flex-start;
      gap: 1rem;
    }

    .hero h1 {
      font-size: 1.9rem;
    }

    .avatar {
      width: 72px;
      height: 72px;
    }
  }
</style>
