---
import { getCollection } from "astro:content";
import { profile } from "../data/resume";
import { Icon } from "astro-icon/components";

// Academic presence strip used on the homepage research block and the
// /research page: ORCID and Google Scholar as brand-glyph squares (the only
// color on the page, matching the hero socials), then a citation total. The
// count element starts hidden and only appears once a number has been
// fetched (live OpenAlex lookup, see src/scripts/researchCitations.ts).
interface Props {
    // "center" for the homepage (under a centered header), "left" for pages.
    align?: "center" | "left";
}
const { align = "left" } = Astro.props;

const allResearch = await getCollection("research");
const scholarTotal = allResearch.reduce((sum, item) => sum + (item.data.scholarCitations || 0), 0);
---

<div class:list={["rlinks", align]}>
    <a
        class="glyph orcid"
        href={profile.orcid}
        target="_blank"
        rel="noopener noreferrer"
        title="ORCID"
        aria-label="ORCID"
    >
        <Icon name="simple-icons:orcid" />
    </a>
    <a
        class="glyph scholar"
        href={profile.googleScholar}
        target="_blank"
        rel="noopener noreferrer"
        title="Google Scholar"
        aria-label="Google Scholar"
    >
        <Icon name="simple-icons:googlescholar" />
    </a>

    <span class="sep" aria-hidden="true"></span>

    {
        scholarTotal > 0 ? (
            <span class="total-line" title="Summed from committed Google Scholar snapshots">
                <span class="total-num">
                    <span>{scholarTotal}</span>
                </span>
                <span class="total-txt">total citations</span>
            </span>
        ) : (
            <span class="total-line" data-total title="Live total from OpenAlex" hidden>
                <span class="total-num">
                    <span class="oa-total">0</span>
                </span>
                <span class="total-txt">total citations</span>
            </span>
        )
    }
</div>

<style>
    .rlinks {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem 0.6rem;
    }

    .rlinks.center {
        justify-content: center;
    }

    /* Reach-me glyph squares, the same recipe as the hero socials: monochrome
       chrome, and the glyph always wears its brand color. */
    .glyph {
        display: grid;
        place-items: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 10px;
        border: 1px solid var(--border);
        color: var(--text);
        background: transparent;
        transition:
            transform 0.15s ease,
            border-color 0.15s ease,
            color 0.15s ease;
    }

    .glyph:hover {
        border-color: var(--text-muted);
        transform: translateY(-1px);
        text-decoration: none;
    }

    .glyph:focus-visible {
        outline: 2px solid var(--text-muted);
        outline-offset: 2px;
    }

    .glyph :global(svg) {
        width: 1.15rem;
        height: 1.15rem;
    }

    .glyph.orcid {
        color: #a6ce39;
    }

    .glyph.scholar {
        color: #4285f4;
    }

    .sep {
        width: 1px;
        height: 1.15rem;
        background: var(--border);
        flex-shrink: 0;
    }

    .total-line {
        display: inline-flex;
        align-items: baseline;
        gap: 0.35rem;
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .total-num {
        font-family: theme("fontFamily.mono");
        font-size: 1.05rem;
        font-weight: 600;
        color: var(--text);
    }

    .total-txt {
        white-space: nowrap;
    }
</style>
